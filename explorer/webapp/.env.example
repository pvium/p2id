# Factory environment from the SDK. No recorded factory means no address is displayed.
NEXT_PUBLIC_P2ID_ENV=production
# Local testing only. Never set this in a public production deployment.
NEXT_PUBLIC_P2ID_FACTORY_OVERRIDE=
# Existing claim app. Claim actions show a launch-pending state when empty.
NEXT_PUBLIC_PVIUM_URL=
# Optional protocol documentation link.
NEXT_PUBLIC_SPEC_URL=
# Optional server-side indexer base URL. GET /tokens; see README.md for the contract.
# When unset, show labelled preview cards. Configured feeds keep real empty/error states.
P2ID_API_URL=
