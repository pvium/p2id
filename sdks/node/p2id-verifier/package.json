{
  "name": "@pvium/p2id-verifier",
  "version": "0.1.0",
  "description": "Pvium's off-chain verifier for P2ID identity attestations (Noir/UltraHonk zero-knowledge proofs)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/embed-vk.mjs && tsc -p tsconfig.json",
    "test": "yarn build && node --test --import tsx test/*.test.ts",
    "sync": "sh scripts/sync-circuit.sh",
    "prepublishOnly": "yarn test"
  },
  "dependencies": {
    "@aztec/bb.js": "5.0.0-nightly.20260522",
    "@pvium/p2id-core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
