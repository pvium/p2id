# Settings of the Solana P2ID deploy script (scripts/deploy.ts). Per-environment values carry a
# suffix: _SANDBOX (devnet, local validator) or _PROD (mainnet). Nothing here is ever printed.

# The Privy app's ES256 keys, every key in its JWKS, as comma-separated kid:0x<x>:0x<y> entries.
# Same values as contracts/.env (one Privy app per environment); left unset, they are read from there.
PRIVY_SIGNER_KEYS_SANDBOX=
PRIVY_SIGNER_KEYS_PROD=
# Optional fallback when the keys above are unset: a JWKS URL or a saved jwks.json.
PRIVY_JWKS_URL_SANDBOX=
PRIVY_JWKS_URL_PROD=

# Factory and policy authority: the Squads multisig vault address (a plain key on devnet).
SOL_AUTHORITY_SANDBOX=
SOL_AUTHORITY_PROD=
# Alpha attester: the backend's ed25519 public key (base58). Omitted uses the authority.
SOL_ALPHA_ATTESTER_SANDBOX=
SOL_ALPHA_ATTESTER_PROD=

# Shared, optional.
# Deployer keypair file (pays rent, holds the upgrade authorities until they are burned).
SOL_DEPLOYER_KEYPAIR=~/.config/solana/id.json
# Where the program keypairs live (default target/deploy; vault the production ones).
SOL_PROGRAM_KEYPAIR_DIR=
# Sunspot verifier program artifact, keypair and verifying key; defaults are the environment's
# entries in releases.json (what circuit/scripts/sunspot-build.sh <environment> writes). Suffix
# them (_SANDBOX/_PROD) to point production at the vaulted keypair.
SOL_ZK_VERIFIER_SO=
SOL_ZK_VERIFIER_KEYPAIR=
SOL_VK_FILE=
# Refund window bounds in seconds (part of the factory PDA; defaults 86400 and 7776000).
MIN_REFUND_WINDOW=
MAX_REFUND_WINDOW=
# RPC URLs (defaults: public endpoints).
SOL_RPC_URL_DEVNET=
SOL_RPC_URL_MAINNET=
SOL_RPC_URL_LOCALNET=
