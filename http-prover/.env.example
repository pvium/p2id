# API requests require an Authorization header containing the AUTH_TOKEN below.
AUTH_TOKEN=local-development-token
PORT=8787

# Local demo signer for circuit/test/fixtures/sample_token.jwt only. Do not use this test key
# or fixture JWT in production. For real tokens, set PRIVY_JWKS_URL and leave the PEM unset.
PRIVY_JWKS_URL=
PRIVY_PUBLIC_KEY_PEM_FILE=../circuit/test/fixtures/privy_es256_public.pem

# Circuit artifacts: committed, pinned by hash in circuit/version.json (`yarn sync` refreshes the Sunspot ACIR; `yarn sync --evm` the Ethereum artifact, for a new circuit version only)
CIRCUIT_JSON=./circuit/pvium_identity.json
VK_PATH=./circuit/vk
CIRCUIT_VERSION_JSON=./circuit/version.json

# Barretenberg must be exactly the version recorded in circuit/version.json (currently 5.0.0).
# This bundled path is for Apple Silicon macOS. Use amd64-macos, amd64-linux or arm64-linux as
# appropriate for your machine. Alternatively, set BB_BIN to an absolute path to a matching bb.
BB_BIN=./node_modules/@aztec/bb.js/build/arm64-macos/bb

# Solana (Sunspot Groth16) proving. Off until a proving key is configured; then the service fetches
# the keys if needed, starts sunspotd (the resident prover, which loads the key once; built by
# circuit/scripts/sunspot-install.sh locally and inside the Docker image) and refuses to come up if
# anything is wrong. The ACIR is the committed circuit/pvium_identity.sunspot.json(.gz) (yarn sync).
# Keys are per environment: sandbox from Sunspot's own setup (circuit/scripts/sunspot-build.sh
# sandbox), production from the ceremony. Locally, point at the files sunspot-build.sh wrote:
SUNSPOTD_BIN=sunspotd
SUNSPOT_PK_PATH=../circuit/target/sunspot/sandbox/pvium_identity.pk
SUNSPOT_VK_PATH=../circuit/target/sunspot/sandbox/pvium_identity.vk
# Deployed: fetch the keys onto the data volume instead (SUNSPOT_PK_PATH/VK_PATH default to
# ./data/sunspot/pvium_identity.{pk,vk}); the hashes are checked on every start (the vk hash is the
# factory's vkHash in solana-anchor/releases.json). Leave the hash unset only for throwaway setups.
SUNSPOT_PK_URL=
SUNSPOT_PK_SHA256=
SUNSPOT_VK_URL=
SUNSPOT_VK_SHA256=
# Optional: where sunspotd keeps the constraint system (276 MB). Unset: compiled on the first start
# (~15 s) and cached next to the proving key as pvium_identity.<acir hash>.ccs; read on later starts.
SUNSPOT_CCS_PATH=

# Ethereum proves take ~3 GB peak each: set to floor((RAM - Solana) / 3 GB), where Solana is ~8 GB
# when enabled (sunspotd keeps the 2.6 GB key resident and proves one at a time, ~11 s each).
MAX_CONCURRENCY=1
# Requests allowed to wait for a slot; beyond this, 503 + Retry-After
MAX_QUEUE=20
# Callback URLs must be https unless this is true (development only)
ALLOW_HTTP_CALLBACKS=false
# SQLite outbox: callback jobs (with their attestations) persist here until delivered
DB_PATH=./data/prover.db
# How often undelivered callbacks are retried (ms)
DISPATCH_INTERVAL_MS=30000
# Scratch dir for witness/proof files (tmpfs such as /dev/shm on Linux keeps tokens off disk)
WORK_DIR=/tmp
