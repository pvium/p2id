{
  "name": "@pvium/zk-prover",
  "version": "0.1.0",
  "private": true,
  "description": "Pvium attestation service: builds the witness, solves the circuit and proves it",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "test": "yarn build && node --test --import tsx test/*.test.ts",
    "sync": "sh scripts/sync-circuit.sh"
  },
  "dependencies": {
    "@noir-lang/noir_js": "1.0.0-beta.26",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@pvium/p2id-verifier": "link:../sdks/node/p2id-verifier",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "resolutions": {
    "@pvium/p2id-core": "link:../sdks/node/p2id-core"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
