# contracts/.env  (git-ignored). Only needed to deploy; tests need none of this.
#
# Networks are listed in deploy.config.ts, each tagged with a Pvium environment:
#   sandbox     baseSepolia                 (sandbox Privy app, testnet stack)
#   production  base, bsc                   (production Privy app, mainnet stack)
# The deploy script reads the values ending in the network's suffix, _SANDBOX or _PROD, so a
# testnet run can never use production keys or owners. Within one environment every chain must
# get identical values: they decide the addresses, and the script refuses a run that differs.

# ---------------------------------------------------------------- sandbox (testnets)
# Initial Privy signing keys (every key in the app's JWKS, kid:x:y). Part of every address: never
# change after the first deploy; later rotations go through PviumIdentity.proposeSignerKey.
# Source: https://auth.privy.io/api/v1/apps/cmhc6t92u001tju0cxkxg34on/jwks.json
PRIVY_SIGNER_KEYS_SANDBOX=Lp_q4NY6tg5jSdiD790AIm01JR7GIJ_xmDVZZ6MVAfM:0x487140ed4fa91d71559b5e015286c9b76c270883f59a5ae9febac9b291584cd1:0xd4cf5625205d28cbe6c8108a695929208c08f3bdc7790ab7023abe17dcdefc04,1NtmKuIrWxOltnhgo5yNIyuFFmi-cQDW1Ucqv2185Og:0x84e87db1d90fb3ef5079e6fbe8a50e8f2aee7f8ad66c13b837cc93e016e2b9aa:0x27a0949bf003bb64d5a622a05737d2547efa8980267daf35cc75276cb30c9de5
# Owner of the factory and the launch policy (timelocked changes, verifier allowlist):
# a Safe at the same address on every sandbox chain.
OWNER_SANDBOX=0x
# Signs screening-constraint commitments, or "none" to disable constraints on this stack.
ATTESTER_SANDBOX=none
# Alpha authorization signer. Omit/leave empty to use OWNER; set to ATTESTER to share a key.
ALPHA_ATTESTER_SANDBOX=

# ---------------------------------------------------------------- production (mainnets)
# Initial Privy signing keys, as above. Source: https://auth.privy.io/api/v1/apps/cmjzq9okg01kwjm0cq4b0xs74/jwks.json
PRIVY_SIGNER_KEYS_PROD=gtxaE3pGoA51jLX-_Oeo75Zif0R3k-tBo7NsQpAy4RI:0x95b9d9d18fbed9f5c3b8aab466271793539be2cbc86a7090dd92f4df600850de:0x3acff34d3319d44a03afdd818474d3551e2b37ee2ff029ceac1ee74924eeb813,w43bEjqKgP4wGge2dXiLR18B83IgjT4rAjjDcXXd7E0:0xf638cd1c8ae040434c3325c1fdfb4d313496b9e4d266017266c803c4e474cada:0x93d01d1f671d945cd44a46142a5c35e9b06c27bdac8d65d77c6996112509d029
OWNER_PROD=0x
ATTESTER_PROD=none
ALPHA_ATTESTER_PROD=

# ---------------------------------------------------------------- deployer
# Pays for the deployment; gets no privileges and does not affect addresses.
# Either one key for everything, or one per environment (the suffixed one wins).
DEPLOYER_KEY=0x
# DEPLOYER_KEY_SANDBOX=0x
# DEPLOYER_KEY_PROD=0x

# ---------------------------------------------------------------- optional
# Shared by both environments unless a _SANDBOX / _PROD variant is set. Defaults shown.
# POLICY_CHANGE_DELAY=604800    # 7 days: notice before a policy change takes effect
#                               (a default-verifier change always needs 14 days, fixed in the factory)
# MIN_REFUND_WINDOW=86400       # 1 day
# MAX_REFUND_WINDOW=7776000     # 90 days
# SCHEME=pvium.vault.v1          # default: `current` in sdks/node/p2id-core/src/p2id.json

# RPC endpoints (public defaults in deploy.config.ts)
# BASE_SEPOLIA_RPC_URL=
# BASE_RPC_URL=
# BSC_RPC_URL=
# ETHERSCAN_API_KEY=            # for `hardhat verify`
